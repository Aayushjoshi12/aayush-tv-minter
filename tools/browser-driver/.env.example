# Browser Driver keys — generated on the VM at deploy time with:
#   openssl rand -hex 32   (run twice, once per key)
# NEVER commit this file, never paste these values into chat.
# The EXTENSION key goes into the extension's Options page (in the browser).
# The CLAUDE key is the one Muse's connector uses (registered separately).
DRIVER_EXTENSION_API_KEY=
DRIVER_CLAUDE_API_KEY=
PORT=8802
